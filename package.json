{
  "name": "ledgerly-whop-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "reconcile": "tsx scripts/reconcile.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "hono": "^4.9.6"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
