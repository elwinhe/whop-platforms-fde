# "sandbox" (default) targets sandbox-api.whop.com; "production" targets api.whop.com.
WHOP_ENV=sandbox
# Credentials for the selected WHOP_ENV. Never commit a real key.
WHOP_API_KEY=
# Required only for `operations key create --apply`; Whop forbids API-key-authenticated API-key creation.
WHOP_USER_TOKEN=
WHOP_PLATFORM_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
# Public HTTPS origin used for Whop return/refresh URLs (use a tunnel locally).
LEDGERLY_PUBLIC_URL=
# Local demo auth. Generate random 24+ character tokens; never use this static mapping in production.
# LEDGERLY_SELLER_SESSIONS=[{"token":"replace-with-a-long-random-token","external_id":"ledgerly_seller_us","email":"you+us@your-domain.com","country":"US"}]
# Separate operator credential for /accounts and /api/accounts. Generate a random 24+ character token.
# Seller session tokens are never accepted as administrator credentials.
LEDGERLY_ADMIN_TOKEN=
LEDGERLY_DB_PATH=data/ledgerly.sqlite
# Mailbox you control for seeded sellers; Whop rejects addresses that cannot receive mail.
SEED_SELLER_EMAIL=
# Optional per-account overrides, for example plus-addressed variants of the same inbox.
# SEED_SELLER_EMAIL_US=
# SEED_SELLER_EMAIL_DE=
# SEED_SELLER_EMAIL_BR=
# SEED_SELLER_EMAIL_NESTED=
WHOP_TIMEOUT_MS=5000
HOST=127.0.0.1
PORT=3000
